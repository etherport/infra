# macOS
.DS_Store

# Claude Code
.claude/

# Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
**/terraform.tfvars.local
**/*.tfvars.local
**/terraform.tfvars.*.local

# Packer
**/*.pkrvars.hcl
!**/*.pkrvars.hcl.example
**/.packer_plugins/
**/packer_cache/

# Ansible/Kubespray artifacts
**/*.retry
**/inventory/**/artifacts/
**/inventory/**/credentials/*
!**/inventory/**/credentials/*.sops.yaml

# SOPS edit tempfiles — sops creates `.decrypted~<name>` while editing,
# which contains the FULL PLAINTEXT secret. Never commit.
**/.decrypted~*

# Kubeconfigs
**/admin.conf
**/*.kubeconfig
**/.kube/
**/kubeconfig/

# Secrets (commit templates only)
**/secrets/*
!docs/setup/secrets/*
**/*secret*.yaml
!**/*secret-template*.yaml
!**/*.secret-template.yaml
!**/*.sops.yaml
!**/secrets/*.manifest.yaml

# Explicitly ignored secret files
platform/kubernetes/cloudflare-ddns/base/secret.yaml

# Config files that may contain credentials (prefer SOPS)
**/alertmanager-config.yaml
**/credentials.yaml
!**/*.sops.yaml
# Generic catch-alls for raw private-key material. All real secrets are
# SOPS-encrypted now (*.sops.yaml — see ~20 files across the repo) so we
# should never have raw keys committed; these patterns are defense in depth.
**/*.key
**/*.pem
# Exception: step-ca ROOT CA is a PUBLIC cert (RA trust-anchor source, M71) — safe to commit
!infra/terraform/aws/roles-anywhere/step-ca-root.pem
**/id_rsa
**/id_rsa.pub
**/id_ed25519
**/id_ed25519.pub
**/wg0.conf
**/wg1.conf
**/wg-private-*.key
.vscode/

# Lambda build artifacts — TF rebuilds these from handler.py on apply.
# Cover both layouts: sometimes zip is written in lambda/, sometimes
# in the parent module dir alongside main.tf.
**/lambda/handler.zip
**/twilio-webhook/handler.zip
**/handler.zip

# HARD re-ignore (must be LAST — last match wins): SOPS decrypt tempfiles.
# `sops`/the VSCode SOPS extension write `.decrypted~<name>` plaintext while
# editing; for `.decrypted~*.sops.yaml` the `!**/*.sops.yaml` force-include
# above would otherwise re-track them = a plaintext-secret LEAK. Confirmed
# 2026-06-20 (git status showed `?? .decrypted~homelab-ops.sops.yaml`).
**/.decrypted~*

# Python bytecode
__pycache__/
*.pyc
