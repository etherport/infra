# macOS
.DS_Store

# Claude Code
.claude/

# Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
!**/*.tfvars.example
**/terraform.tfvars.local
**/*.tfvars.local
**/terraform.tfvars.*.local

# Packer
**/*.pkrvars.hcl
!**/*.pkrvars.hcl.example
**/.packer_plugins/
**/packer_cache/

# Ansible/Kubespray artifacts
**/*.retry
**/inventory/**/artifacts/
**/inventory/**/credentials/

# Kubeconfigs
**/admin.conf
**/*.kubeconfig
**/.kube/
**/kubeconfig/

# Secrets (commit templates only)
**/secrets/*
!docs/setup/secrets/*
**/*secret*.yaml
!**/*secret-template*.yaml
!**/*.secret-template.yaml
!**/*.sops.yaml

# Explicitly ignored secret files
platform/kubernetes/icloudpd/04-icloud-cookies-secret.yaml
platform/kubernetes/route53-ddns/base/secret.yaml

# Config files that may contain credentials (prefer SOPS)
**/alertmanager-config.yaml
**/credentials.yaml
!**/*.sops.yaml
backups/
