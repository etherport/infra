Documentation=https://github.com/sparked-diamond/infra/blob/main/docs/planning/m76-ssh-shortlived-plan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/ubuntu/code/infra/infra/devbox/step-ssh-renew.sh
