<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.wind.icloud-files</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/grahamsmith/code/infra/infra/macos/mini/icloud-files-backup.sh</string>
  </array>
  <!-- 19:30 PT — staggered before messages (20:00) / DAV (21:00) / photos (22:00), all before
       the 01:00 s3-sync. Needs Full Disk Access on /bin/bash (same grant as Messages). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/grahamsmith/Library/Logs/icloud-files.log</string>
  <key>StandardErrorPath</key><string>/Users/grahamsmith/Library/Logs/icloud-files.log</string>
</dict>
</plist>
