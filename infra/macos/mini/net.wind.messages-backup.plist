<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.wind.messages-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/grahamsmith/code/infra/infra/macos/mini/messages-backup.sh</string>
  </array>
  <!-- 20:00 PT — staggered before icloud-dav (21:00) + photos-export (22:00) to spread NAS
       load, and well before the 01:00 s3-sync so the day's backup ships offsite same night. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>20</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/grahamsmith/Library/Logs/messages-backup.log</string>
  <key>StandardErrorPath</key><string>/Users/grahamsmith/Library/Logs/messages-backup.log</string>
</dict>
</plist>
