<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.wind.mini-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/grahamsmith/code/infra/infra/macos/mini/mini-health.sh</string>
  </array>
  <!-- Heartbeat every 15 min (push mini_health_*). RunAtLoad so it reports right after login. -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/grahamsmith/Library/Logs/mini-health.log</string>
  <key>StandardErrorPath</key><string>/Users/grahamsmith/Library/Logs/mini-health.log</string>
</dict>
</plist>
