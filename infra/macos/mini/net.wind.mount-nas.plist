<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.wind.mount-nas</string>

  <!-- Idempotent mount script lives in the git checkout so `git pull` updates it.
       Adjust this path if the repo isn't at /Users/grahamsmith/code/infra. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/grahamsmith/code/infra/infra/macos/mini/mount-nas.sh</string>
  </array>

  <!-- Mount as soon as the user (Aqua) session starts (= at auto-login). -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Re-run every 3 min (2026-07-09). The OLD design (RunAtLoad + KeepAlive{SuccessfulExit=false})
       ran ONLY at login and only relaunched while FAILING — so once the mount succeeded at login it
       never ran again, and a mid-session SMB drop was never recovered (the 2026-07-03→09 outage:
       backups down 6 days, silent). StartInterval makes launchd re-run the idempotent script
       periodically, so a dropped-but-re-authable mount self-heals within ~3 min. The script's auth
       pre-check makes a periodic run safe during an AUTH outage (it bails without spamming NetAuth
       GUI prompts). KeepAlive removed: with StartInterval, a failing run must NOT tight-loop. -->
  <key>StartInterval</key>
  <integer>180</integer>

  <key>StandardOutPath</key>
  <string>/Users/grahamsmith/Library/Logs/mount-nas.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/grahamsmith/Library/Logs/mount-nas.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
