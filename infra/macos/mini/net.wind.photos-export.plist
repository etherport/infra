<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.wind.photos-export</string>

  <!-- M79: osxphotos export of the iCloud Photos library → NAS Backups share.
       Lives in the git checkout so `git pull` updates it. Adjust path if the
       repo isn't at /Users/grahamsmith/code/infra. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/grahamsmith/code/infra/infra/macos/mini/photos-export.sh</string>
  </array>

  <!-- Daily at 22:00 PT — finishes before the 01:00 PT s3-sync-backups CronJob so
       each night's export ships offsite the same night. (First full export after
       "Download Originals" can run for hours/days; --update keeps steady state fast.) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Periodic job, not a daemon: do NOT KeepAlive. If the mini is asleep at 22:00,
       launchd runs it on next wake. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/grahamsmith/Library/Logs/photos-export.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/grahamsmith/Library/Logs/photos-export.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- Don't let App Nap / low-power throttle a multi-hour export into oblivion. -->
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
