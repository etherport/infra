# vdirsyncer config — one-way BACKUP of iCloud Contacts + Calendars to the NAS (M80).
# Installed to ~/.config/vdirsyncer/config (icloud-dav-backup.sh points VDIRSYNCER_CONFIG here).
#
# SAFETY: the iCloud (remote) storages are read_only=true — vdirsyncer will NEVER write/delete
# on iCloud, so a corrupted/empty local mirror cannot propagate as a deletion of your real
# contacts/calendars. It only ever pulls iCloud -> local. (conflict_resolution "b wins" = iCloud
# is authoritative.) status_path is LOCAL (not on SMB) for reliability.
#
# CREDENTIAL: app-specific password fetched at runtime from the SOPS bundle via
# icloud-app-password.sh — nothing secret is stored here.

[general]
status_path = "~/.local/share/vdirsyncer/status/"

# ---- Contacts (CardDAV) -> /Backups/Graham/iCloud/Contacts ----
[pair contacts]
a = "contacts_local"
b = "contacts_remote"
collections = ["from b"]
conflict_resolution = "b wins"

[storage contacts_local]
type = "filesystem"
# LOCAL staging (NOT the SMB share): writing many small files straight to SMB stalls the
# iCloud connection until it drops ("Server disconnected"). icloud-dav-backup.sh rsyncs this
# staging to the /Backups/Graham/iCloud/Contacts master location afterward.
path = "~/.local/share/icloud-dav/Contacts/"
fileext = ".vcf"

[storage contacts_remote]
type = "carddav"
url = "https://contacts.icloud.com/"
username = "graham.m.smith@mac.com"
password.fetch = ["command", "/Users/grahamsmith/code/infra/infra/macos/mini/icloud-app-password.sh"]
read_only = true

# ---- Calendars (CalDAV) -> /Backups/Graham/iCloud/Calendars ----
[pair calendars]
a = "calendars_local"
b = "calendars_remote"
collections = ["from b"]
conflict_resolution = "b wins"

[storage calendars_local]
type = "filesystem"
# LOCAL staging (see contacts_local note); icloud-dav-backup.sh rsyncs this to Backups after.
# NB: vdirsyncer's INI parser rejects inline `#` comments on a value line — keep comments on
# their own line above the option, never trailing the value.
path = "~/.local/share/icloud-dav/Calendars/"
fileext = ".ics"

[storage calendars_remote]
type = "caldav"
url = "https://caldav.icloud.com/"
username = "graham.m.smith@mac.com"
password.fetch = ["command", "/Users/grahamsmith/code/infra/infra/macos/mini/icloud-app-password.sh"]
read_only = true
