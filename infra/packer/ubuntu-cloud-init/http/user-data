#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Network - static IP during build so Packer doesn't depend on the guest
  # agent to discover the VM's address. This IP is only used while building
  # the template; cloned VMs get their own network config from cloud-init
  # at clone time. .99 is chosen to be outside the DHCP pool and the K8s/
  # standalone-VM ranges.
  network:
    version: 2
    ethernets:
      ens18:
        addresses:
          - 10.10.201.99/24
        routes:
          - to: default
            via: 10.10.201.1
        nameservers:
          addresses: [10.10.201.5, 10.10.201.6]

  # Storage - simple layout, will be resized by Terraform
  storage:
    layout:
      name: direct
    swap:
      size: 0

  # Explicit APT sources so package install during autoinstall doesn't fall
  # back to the live ISO's CD-ROM-only sources (which lack qemu-guest-agent
  # and others, causing exit 100 during install_qemu-guest-agent step).
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
      - arches: [amd64, i386]
        uri: http://archive.ubuntu.com/ubuntu
      - arches: [default]
        uri: http://ports.ubuntu.com/ubuntu-ports

  # User account - using 'ubuntu' to match AWS EC2 defaults.
  # Password is 'ubuntu' (verified hash). Used for console recovery only;
  # SSH password auth is disabled below.
  identity:
    hostname: ubuntu-template
    username: ubuntu
    password: "$6$R6zzPLmgQ8cYD$7b.PyMRQ8IYbYRELRM3vcoQbvLN2TRD1L0eOyTusyVn57Y05pWgpvwTnSm/g/.F00M5lZCI3TFBXJ.1S5SsyG1"

  # SSH configuration - subiquity writes the authorized key for the ubuntu
  # user directly during install. No cloud-init users: trickery needed.
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDbuFR+hru9VgMct+C7pCxrxXB0O3mrhFcBP3QJ/D8IR automation@homelab

  # Stop the live installer's SSH so it doesn't conflict with the target's
  # SSH coming up after reboot.
  early-commands:
    - sudo systemctl stop ssh

  # Packages to install during autoinstall. Keep this list to main-only
  # packages that the live ISO can definitely retrieve. qemu-guest-agent is
  # in universe and the curtin postinstall phase fails to fetch it (exit 100,
  # 'No such file or directory' from apt cache) even with apt.primary set —
  # likely because curtin's postinstall sources don't pick up universe. We
  # install it on first boot via cloud-init user-data below instead.
  packages:
    - openssh-server
    - cloud-init
    - cloud-guest-utils
    - python3
    - curl
    - wget
    - ca-certificates

  # cloud-init user-data baked into the installed system. With HTTP datasource
  # (no CIDATA staying attached), subiquity writes this as the local NoCloud
  # seed, and cloud-init applies it cleanly on first boot — no more conflict
  # with re-reading the original autoinstall YAML.
  user-data:
    package_update: true
    package_upgrade: false
    packages:
      - qemu-guest-agent
    runcmd:
      - [systemctl, enable, --now, qemu-guest-agent]

  # Late commands - minimal. Anything that exits non-zero aborts the whole
  # install, so we keep this short and `|| true` non-essential pieces.
  late-commands:
    - "echo 'datasource_list: [NoCloud, ConfigDrive]' > /target/etc/cloud/cloud.cfg.d/99-proxmox.cfg"
    - "curtin in-target --target=/target -- systemctl enable ssh || true"
    # Force-set the ubuntu password to 'ubuntu' and unlock the account.
    # Subiquity's identity.password field doesn't reliably end up working
    # in the installed system (account stays locked or hash doesn't take).
    # Setting it explicitly via chpasswd guarantees console login works.
    - "echo 'ubuntu:ubuntu' | curtin in-target --target=/target -- chpasswd || true"
    - "curtin in-target --target=/target -- passwd -u ubuntu || true"
    - "date -u +%FT%TZ > /target/var/log/autoinstall-completed || true"

  # Reboot after installation
  shutdown: reboot
