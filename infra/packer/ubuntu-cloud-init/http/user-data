#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Network - DHCP during install, cloud-init will reconfigure later
  network:
    version: 2
    ethernets:
      ens18:
        dhcp4: true

  # Storage - simple layout, will be resized by Terraform
  storage:
    layout:
      name: direct
    swap:
      size: 0

  # Explicit APT sources so package install during autoinstall doesn't fall
  # back to the live ISO's CD-ROM-only sources (which lack qemu-guest-agent
  # and others, causing exit 100 during install_qemu-guest-agent step).
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
      - arches: [amd64, i386]
        uri: http://archive.ubuntu.com/ubuntu
      - arches: [default]
        uri: http://ports.ubuntu.com/ubuntu-ports

  # User account - using 'ubuntu' to match AWS EC2 defaults.
  # Password is 'ubuntu' (verified hash). Used for console recovery only;
  # SSH password auth is disabled below.
  identity:
    hostname: ubuntu-template
    username: ubuntu
    password: "$6$R6zzPLmgQ8cYD$7b.PyMRQ8IYbYRELRM3vcoQbvLN2TRD1L0eOyTusyVn57Y05pWgpvwTnSm/g/.F00M5lZCI3TFBXJ.1S5SsyG1"

  # SSH configuration - subiquity writes the authorized key for the ubuntu
  # user directly during install. No cloud-init users: trickery needed.
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDbuFR+hru9VgMct+C7pCxrxXB0O3mrhFcBP3QJ/D8IR automation@homelab

  # Stop the live installer's SSH so it doesn't conflict with the target's
  # SSH coming up after reboot.
  early-commands:
    - sudo systemctl stop ssh

  # Packages to install during autoinstall. qemu-guest-agent has to be here
  # so Proxmox can report the VM's IP to Packer once the VM reboots.
  packages:
    - openssh-server
    - cloud-init
    - cloud-guest-utils
    - qemu-guest-agent
    - python3
    - curl
    - wget
    - ca-certificates

  # Late commands - minimal. Anything that exits non-zero aborts the whole
  # install, so we keep this short and `|| true` non-essential pieces.
  late-commands:
    - "echo 'datasource_list: [NoCloud, ConfigDrive]' > /target/etc/cloud/cloud.cfg.d/99-proxmox.cfg"
    - "curtin in-target --target=/target -- systemctl enable ssh || true"
    - "curtin in-target --target=/target -- systemctl enable qemu-guest-agent || true"
    - "date -u +%FT%TZ > /target/var/log/autoinstall-completed || true"

  # Reboot after installation
  shutdown: reboot
