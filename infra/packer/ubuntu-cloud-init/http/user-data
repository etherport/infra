#cloud-config
# Log everything cloud-init does on the live system to a file we can
# inspect after build (helpful when subiquity events scroll off the
# console mid-install).
output: {all: '| tee -a /var/log/cloud-init-output.log'}
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Network - DHCP during install. The build VM gets a dynamic IP; Packer
  # discovers it via the QEMU guest agent (installed in late-commands below).
  network:
    version: 2
    ethernets:
      ens18:
        dhcp4: true

  # Storage - simple layout, will be resized by Terraform
  storage:
    layout:
      name: direct
    swap:
      size: 0

  # Explicit APT sources so package install during autoinstall doesn't fall
  # back to the live ISO's CD-ROM-only sources (which lack qemu-guest-agent
  # and others, causing exit 100 during install_qemu-guest-agent step).
  apt:
    geoip: true
    preserve_sources_list: false
    primary:
      - arches: [amd64, i386]
        uri: http://archive.ubuntu.com/ubuntu
      - arches: [default]
        uri: http://ports.ubuntu.com/ubuntu-ports

  # User account - using 'ubuntu' to match AWS EC2 defaults.
  # Password is 'ubuntu' (verified hash). Used for console recovery only;
  # SSH password auth is disabled below.
  identity:
    hostname: ubuntu-template
    username: ubuntu
    password: "$6$R6zzPLmgQ8cYD$7b.PyMRQ8IYbYRELRM3vcoQbvLN2TRD1L0eOyTusyVn57Y05pWgpvwTnSm/g/.F00M5lZCI3TFBXJ.1S5SsyG1"

  # SSH configuration - subiquity writes the authorized key for the ubuntu
  # user directly during install. No cloud-init users: trickery needed.
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDbuFR+hru9VgMct+C7pCxrxXB0O3mrhFcBP3QJ/D8IR automation@homelab

  # Stop the live installer's SSH so it doesn't conflict with the target's
  # SSH coming up after reboot.
  early-commands:
    - sudo systemctl stop ssh

  # Packages to install during autoinstall. qemu-guest-agent is excluded —
  # it consistently fails with exit 100 during curtin's postinstall
  # --download-only step (not a memory issue, not an apt-sources issue;
  # likely curtin's postinstall apt has a bug or quirk with this specific
  # package). We install it manually after the system is up.
  packages:
    - openssh-server
    - cloud-init
    - cloud-guest-utils
    - python3
    - curl
    - wget
    - ca-certificates

  # Late commands - minimal. Anything that exits non-zero aborts the whole
  # install, so EVERY command here uses `|| true`.
  late-commands:
    - "echo 'datasource_list: [NoCloud, ConfigDrive]' > /target/etc/cloud/cloud.cfg.d/99-proxmox.cfg || true"
    - "curtin in-target --target=/target -- systemctl enable ssh || true"
    # Diagnostic: capture pre-state so we can see if ubuntu user/shadow
    # exist at late-commands time and what their entries look like.
    - "ls -la /target/etc/shadow /target/etc/passwd /target/usr/sbin/chpasswd > /target/var/log/autoinstall-debug.log 2>&1 || true"
    - "grep '^ubuntu' /target/etc/passwd /target/etc/shadow >> /target/var/log/autoinstall-debug.log 2>&1 || true"
    # Primary attempt: chpasswd. Wrapped in bash -c so the echo pipe runs
    # INSIDE the chroot rather than in the live shell.
    - "curtin in-target --target=/target -- bash -c 'echo ubuntu:ubuntu | chpasswd' || true"
    # Fallback: directly inject a known-good SHA-512 hash for 'ubuntu' into
    # /etc/shadow on the target. Works even if chpasswd/PAM is broken in
    # the chroot. The hash here was verified to decode to 'ubuntu'.
    - "sed -i 's|^ubuntu:[^:]*:|ubuntu:$6$R6zzPLmgQ8cYD$7b.PyMRQ8IYbYRELRM3vcoQbvLN2TRD1L0eOyTusyVn57Y05pWgpvwTnSm/g/.F00M5lZCI3TFBXJ.1S5SsyG1:|' /target/etc/shadow || true"
    # Make sure the account isn't locked (sed above strips a leading '!' if any)
    - "curtin in-target --target=/target -- passwd -u ubuntu || true"
    # Final state dump: what /etc/shadow actually contains for ubuntu now.
    - "grep '^ubuntu:' /target/etc/shadow > /target/var/log/autoinstall-shadow.log 2>&1 || true"
    - "date -u +%FT%TZ > /target/var/log/autoinstall-completed || true"

  # Reboot after installation
  shutdown: reboot
