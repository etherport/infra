# Example configuration for external monitoring
# Copy to terraform.tfvars and customize

alert_email    = "your-email@example.com"
homelab_domain = "wind.etherport.net"

# Customize endpoints as needed
endpoints = {
  home-assistant = {
    fqdn              = "ha.wind.etherport.net"
    port              = 443
    type              = "HTTPS"
    resource_path     = "/api/"
    failure_threshold = 2
    request_interval  = 30
    enabled           = true
  }
  grafana = {
    fqdn              = "grafana.wind.etherport.net"
    port              = 443
    type              = "HTTPS"
    resource_path     = "/api/health"
    search_string     = "ok"
    failure_threshold = 3
    request_interval  = 30
    enabled           = true
  }
  traefik = {
    fqdn              = "traefik.wind.etherport.net"
    port              = 443
    type              = "HTTPS"
    resource_path     = "/ping"
    failure_threshold = 3
    request_interval  = 30
    enabled           = true
  }
}
