{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateClaudeRolesOnlyWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::830881980142:role/claude-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::830881980142:policy/claude-oneoff-boundary"
        }
      }
    },
    {
      "Sid": "ManageClaudeRolePoliciesAndLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::830881980142:role/claude-*"
    },
    {
      "Sid": "PassClaudeRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::830881980142:role/claude-*"
    },
    {
      "Sid": "ManageClaudeInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": "arn:aws:iam::830881980142:instance-profile/claude-*"
    },
    {
      "Sid": "DenyBoundaryTamperingSoRolesStayCapped",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::830881980142:role/claude-*"
    }
  ]
}
