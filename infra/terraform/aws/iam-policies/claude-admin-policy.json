{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IAMPolicyManagement",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicies",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::830881980142:policy/terraform-*"
    },
    {
      "Sid": "IAMGroupManagement",
      "Effect": "Allow",
      "Action": [
        "iam:GetGroup",
        "iam:ListGroups",
        "iam:ListAttachedGroupPolicies",
        "iam:ListGroupPolicies",
        "iam:AttachGroupPolicy",
        "iam:DetachGroupPolicy",
        "iam:PutGroupPolicy",
        "iam:DeleteGroupPolicy",
        "iam:GetGroupPolicy"
      ],
      "Resource": "arn:aws:iam::830881980142:group/terraform-*"
    },
    {
      "Sid": "IAMReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:ListUsers",
        "iam:ListGroups",
        "iam:ListPolicies",
        "iam:GetUser",
        "iam:GetRole",
        "iam:ListRoles",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetRolePolicy",
        "iam:ListGroupsForUser",
        "iam:ListAttachedUserPolicies",
        "iam:ListEntitiesForPolicy",
        "iam:ListUserPolicies",
        "iam:ListAccessKeys"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMOrphanCleanup",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteAccessKey",
        "iam:DetachUserPolicy",
        "iam:DeleteUser"
      ],
      "Resource": "arn:aws:iam::830881980142:user/terraform-*"
    },
    {
      "Sid": "IAMPolicyTagging",
      "Effect": "Allow",
      "Action": [
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::830881980142:policy/terraform-*"
    },
    {
      "Sid": "ResourceDiscoveryReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "route53:List*",
        "route53:Get*",
        "route53domains:Get*",
        "route53domains:List*",
        "lambda:List*",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketVersioning",
        "s3:GetBucketTagging",
        "s3:GetBucketLifecycleConfiguration",
        "s3:GetBucketNotification",
        "s3:GetBucketEncryption",
        "s3:GetBucketPublicAccessBlock",
        "sns:List*",
        "sns:GetTopicAttributes",
        "sns:GetSubscriptionAttributes",
        "cloudwatch:Describe*",
        "cloudwatch:List*",
        "cloudwatch:GetMetricData",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:DescribeMetricFilters",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "apigateway:GET",
        "secretsmanager:ListSecrets",
        "secretsmanager:DescribeSecret",
        "elasticloadbalancing:Describe*",
        "events:List*",
        "events:DescribeRule",
        "events:ListTargetsByRule",
        "ses:GetIdentityVerificationAttributes",
        "ses:ListIdentities",
        "ses:GetSendStatistics",
        "dynamodb:ListTables",
        "dynamodb:DescribeTable",
        "acm:ListCertificates",
        "acm:DescribeCertificate",
        "wafv2:List*",
        "wafv2:GetWebACL",
        "tag:GetResources",
        "tag:GetTagKeys",
        "tag:GetTagValues",
        "cloudfront:List*",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "kms:ListKeys",
        "kms:ListAliases",
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "datasync:List*",
        "datasync:DescribeTask",
        "datasync:DescribeLocation*",
        "datasync:DescribeAgent",
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "budgets:ViewBudget",
        "budgets:DescribeBudgets"
      ],
      "Resource": "*"
    }
  ]
}
