{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BypassAndDeletePhotoDupeVersions",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": "arn:aws:s3:::archive.wind.etherport.net/objects/backups/Graham/iCloud/Photos/*"
    },
    {
      "Sid": "ListPhotoVersions",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::archive.wind.etherport.net",
      "Condition": {
        "StringLike": {
          "s3:prefix": "objects/backups/Graham/iCloud/Photos/*"
        }
      }
    }
  ]
}
