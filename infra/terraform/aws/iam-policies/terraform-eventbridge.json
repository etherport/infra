{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventBridgeRead",
      "Effect": "Allow",
      "Action": [
        "events:ListRules",
        "events:DescribeRule",
        "events:ListTargetsByRule",
        "events:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EventBridgeManage",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:DeleteRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "events:EnableRule",
        "events:DisableRule",
        "events:TagResource",
        "events:UntagResource"
      ],
      "Resource": "arn:aws:events:us-west-2:830881980142:rule/*"
    }
  ]
}
