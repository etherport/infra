# Email configuration for daily backup reports and notifications
# Emails are sent via AWS SES - sender must be verified in SES console

# Enable/disable email sending globally
EMAIL_ENABLED=true

# Send email notifications on job failures (individual backup jobs)
EMAIL_ON_FAILURE=true

# Sender email address (must be verified in AWS SES)
EMAIL_FROM=alerts@wind.etherport.net

# Display name for sender
EMAIL_FROM_NAME=Sync Alerts

# Recipient email address
EMAIL_TO=graham.m.smith@me.com

# Subject line for daily summary emails
EMAIL_SUBJECT=Sequoia to S3 Sync Report