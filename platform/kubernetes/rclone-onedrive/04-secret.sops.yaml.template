# Template for the OneDrive rclone config secret (NOT applied — the real file is
# 04-secret.sops.yaml, SOPS-encrypted, created once the OAuth token exists).
#
# Produce the [onedrive] block on a machine WITH A BROWSER (the OAuth flow can't
# run headless on the devbox):
#   1. install rclone, then:  rclone config
#   2. n (new remote) -> name: onedrive -> storage: onedrive
#   3. leave client_id / client_secret blank (use rclone's built-in app)
#   4. region: 1 (Microsoft Cloud Global)
#   5. browser opens -> log into the personal Microsoft account (the one with the
#      M365 subscription) -> allow
#   6. "Choose drive type": pick OneDrive Personal -> confirm the listed drive
#   7. rclone config show onedrive    # copy the whole [onedrive] block below
#
# Then hand me that block; I seal it with:
#   sops --encrypt --in-place 04-secret.sops.yaml
# and uncomment it in kustomization.yaml + register the component in
# clusters/wind/kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: rclone-onedrive-config
  namespace: rclone
type: Opaque
stringData:
  rclone.conf: |
    [onedrive]
    type = onedrive
    token = {"access_token":"REPLACE","token_type":"Bearer","refresh_token":"REPLACE","expiry":"REPLACE"}
    drive_id = REPLACE
    drive_type = personal
