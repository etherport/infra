# Template for the CF API token Secret the route53-ddns CronJob uses
# (despite the directory name, it writes to Cloudflare since the
# 2026-05-27 migration).
#
# How to use (one-time setup, ~2 min):
#
# 1. Get a Cloudflare API token with these scopes:
#      Zone — Zone     — Read
#      Zone — DNS      — Edit
#    Zone resource: include — specific zone — etherport.net
#    Either reuse cloudflare-tf-token (already has them) or create a
#    dedicated route53-ddns token for separate rotation.
#
# 2. Copy this template + edit the real file:
#      cd platform/kubernetes/route53-ddns/base
#      cp cloudflare-credentials.sops.yaml.template cloudflare-credentials.sops.yaml
#      sops cloudflare-credentials.sops.yaml
#    Replace REPLACE_WITH_CF_TOKEN with the actual token.
#
# 3. Update kustomization.yaml:
#      - Add `cloudflare-credentials.sops.yaml` as a resource
#      - Drop `01-route53-secret.sops.yaml` (no longer used; AWS creds dead)
#      - Bonus: drop 01-route53-secret.sops.yaml.template too
#
# 4. Un-suspend the CronJob:
#      Set `suspend: false` in cronjob.yaml (or remove the field).
#
# 5. Commit + push. Flux reconciles within ~1 min. The next CronJob
#    fire (within 1 min after suspend=false) should log "Updated
#    successfully" rather than the NoSuchHostedZone errors.
#
# 6. Verify:
#      kubectl -n route53-ddns get jobs --sort-by=.metadata.creationTimestamp | tail -3
#      kubectl -n route53-ddns logs -l app=route53-ddns --tail=30
#    Expected: a log entry with "Cloudflare Dynamic DNS Updater" header
#    and either "Updated successfully" or "No change needed".
#
# 7. Post-cutover cleanup (~5 min):
#      - Delete 01-route53-secret.sops.yaml + .template
#      - Delete the live secret: kubectl -n route53-ddns delete secret route53-ddns-credentials
#      - Revoke the AWS access key on the IAM user that backed it
#      - The image still bundles aws-cli; image rebuild to drop it is
#        nice-to-have but not blocking.
apiVersion: v1
kind: Secret
metadata:
    name: cloudflare-credentials
    namespace: route53-ddns
type: Opaque
stringData:
    CF_API_TOKEN: REPLACE_WITH_CF_TOKEN
