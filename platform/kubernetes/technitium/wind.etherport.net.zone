$ORIGIN wind.etherport.net.
$TTL 3600

; SOA Record
@       IN      SOA     dns.wind.etherport.net. admin.wind.etherport.net. (
                        2026010201      ; Serial (YYYYMMDDNN)
                        3600            ; Refresh (1 hour)
                        600             ; Retry (10 minutes)
                        604800          ; Expire (1 week)
                        300             ; Minimum TTL (5 minutes)
                        )

; NS Records
@       IN      NS      dns.wind.etherport.net.

; ============================================================
; Infrastructure - Direct Access
; ============================================================
windroute       IN      A       10.10.200.1         ; Router
pve             IN      A       10.10.200.41        ; Proxmox (direct)
sequoia         IN      A       10.10.209.10        ; NAS/Storage

; ============================================================
; VPN
; ============================================================
vpn-local       IN      A       10.10.201.15        ; Local VPN endpoint
vpn-aws         IN      A       10.10.100.10        ; AWS VPN endpoint

; ============================================================
; Client Devices
; ============================================================
print           IN      A       10.10.202.20        ; Printer
gdisplay        IN      A       10.10.202.45        ; Google Display

; ============================================================
; Security
; ============================================================
protect         IN      A       10.10.212.10        ; UniFi Protect

; ============================================================
; Kubernetes Cluster Nodes
; ============================================================
k8s-cp1         IN      A       10.10.201.50        ; Control Plane
k8s-w1          IN      A       10.10.201.51        ; Worker 1
k8s-w2          IN      A       10.10.201.52        ; Worker 2
k8s-gpu1        IN      A       10.10.201.53        ; GPU Worker

; ============================================================
; Traefik-Proxied Services (SSL termination via Traefik)
; All point to Traefik LoadBalancer VIP
; ============================================================
traefik         IN      A       10.10.201.70        ; Traefik Dashboard
plex            IN      A       10.10.201.70        ; Plex Media Server
grafana         IN      A       10.10.201.70        ; Grafana Monitoring
kopia           IN      A       10.10.201.70        ; Kopia Backup UI
ha              IN      A       10.10.201.70        ; Home Assistant
dns             IN      A       10.10.201.70        ; Technitium Web UI
prox            IN      A       10.10.201.70        ; Proxmox Web UI (via Traefik)

; Infrastructure Management (via Traefik for SSL)
ups1            IN      A       10.10.201.70        ; UPS 1 Management
ups2            IN      A       10.10.201.70        ; UPS 2 Management
pdu1            IN      A       10.10.201.70        ; PDU 1 Management
pdu2            IN      A       10.10.201.70        ; PDU 2 Management
