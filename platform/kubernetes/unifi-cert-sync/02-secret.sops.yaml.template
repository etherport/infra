# Template for the unifi-cert-sync SSH key Secret.
# To populate:
#   1. Generate a dedicated ed25519 keypair:
#        ssh-keygen -t ed25519 -f /tmp/unifi-cert-sync -C "unifi-cert-sync@homelab" -N ""
#   2. Store the PUBLIC key in 1Password as "UniFi cert-sync SSH key (public)"
#   3. Add the PUBLIC key to /root/.ssh/authorized_keys on each UniFi
#      device (UDM, Protect, UNAS) — one-time manual setup
#   4. Fill in this file with the PRIVATE key + known_hosts entries,
#      then SOPS-encrypt:
#        cp 02-secret.sops.yaml.template 02-secret.sops.yaml
#        # edit, paste private key + known_hosts
#        sops --encrypt --in-place 02-secret.sops.yaml
#   5. Commit the encrypted file. NEVER commit the unencrypted version.
#
# known_hosts: get via `ssh-keyscan` from a trusted vantage point:
#   ssh-keyscan -t ed25519 10.10.200.1 10.10.212.10 <unas-ip> > known_hosts
apiVersion: v1
kind: Secret
metadata:
  name: unifi-cert-sync-ssh
  namespace: unifi-cert-sync
type: Opaque
stringData:
  id_ed25519: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    <paste private key here>
    -----END OPENSSH PRIVATE KEY-----
  known_hosts: |
    10.10.200.1 ssh-ed25519 AAAAC3Nz...
    10.10.212.10 ssh-ed25519 AAAAC3Nz...
