# TEMPLATE — not applied by Flux (the `.example` suffix keeps it out of both
# the SOPS creation rule and the kustomization). To activate unifi-poller:
#
#   1. Create a UniFi local account (UniFi OS → Admins → Add Admin → "Restrict
#      to local access only", role "View Only"). Use it ONLY for this exporter.
#   2. cp 01-secret.sops.yaml.example 01-secret.sops.yaml
#   3. Fill username/password below in the copy.
#   4. sops -e -i platform/kubernetes/unifi-poller/01-secret.sops.yaml
#   5. Uncomment `01-secret.sops.yaml` in this dir's kustomization.yaml AND the
#      `- ../../platform/kubernetes/unifi-poller` line in
#      clusters/wind/kustomization.yaml, then commit. Flux reconciles.
#
# See README.md in this directory for the full runbook + Grafana dashboards.
---
apiVersion: v1
kind: Secret
metadata:
  name: unifi-poller-creds
  namespace: unifi-poller
type: Opaque
stringData:
  # UniFi local View-Only admin — keep distinct from the tf-admin account.
  username: REPLACE_ME_VIEW_ONLY_USER
  password: REPLACE_ME_VIEW_ONLY_PASSWORD
