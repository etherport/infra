{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Container images managed by Flux - disable Renovate",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": [
        "ollama/ollama",
        "open-webui/open-webui",
        "technitium/dns-server",
        "requarks/wiki",
        "plexinc/pms-docker",
        "kopia/kopia",
        "rclone/rclone",
        "icloudpd/icloudpd",
        "home-assistant/home-assistant",
        "^python$",
        "^busybox$"
      ],
      "enabled": false
    },
    {
      "description": "Custom images - disable",
      "matchDatasources": ["docker"],
      "matchPackagePatterns": [
        "sparked-diamond"
      ],
      "enabled": false
    }
  ]
}
