{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "at any time"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 8,
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group GitHub Actions updates (github-actions datasource) into one tidy PR; helpers:pinGitHubActionDigests keeps them digest-pinned",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group Terraform provider + module updates (terraform datasource) into one PR",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "terraform providers"
    },
    {
      "description": "Group pre-commit hook updates (pre-commit manager, enabled above) into one PR",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Container images managed by Flux - disable Renovate",
      "matchDatasources": [
        "docker"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/ollama/ollama/",
        "/open-webui/open-webui/",
        "/technitium/dns-server/",
        "/requarks/wiki/",
        "/plexinc/pms-docker/",
        "/kopia/kopia/",
        "/rclone/rclone/",
        "/home-assistant/home-assistant/",
        "/^python$/",
        "/^busybox$/"
      ]
    },
    {
      "description": "Custom images - disable",
      "matchDatasources": [
        "docker"
      ],
      "enabled": false,
      "matchPackageNames": [
        "/sparked-diamond/"
      ]
    },
    {
      "description": "MetalLB Helm chart (Flux) is on the critical BGP path — it carries every ingress + DNS VIP with no L2 fallback (L24 FRR). Don't auto-merge a bump silently; let it land as a reviewable PR after a settle period (the MetallbBGPAllSessionsDown alert + BGP graceful-restart backstop a bad bump, but a human should sign off).",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "metallb"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ]
}
